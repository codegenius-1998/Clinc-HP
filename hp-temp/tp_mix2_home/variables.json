{
  "$schema": "../schema/template-variables.schema.json",
  "templateId": "tp_mix2_home",
  "version": 1,
  "meta": {
    "label": "ホーム・介護施設（医療転用可）",
    "themeFile": "css/theme.css",
    "htmlFile": "index.html",
    "notes": "AI/管理画面は TEMPLATE_VARIABLES.md の適用手順に従うこと。"
  },
  "apply": {
    "htmlFile": "index.html",
    "themeAttribute": "html[data-theme]",
    "controlsCssFile": "css/site-controls.css",
    "customCssFile": "css/custom.css",
    "layoutStyleTarget": "html"
  },
  "colorScheme": {
    "active": "olive",
    "options": {
      "olive": {
        "label": "オリーブ",
        "tokens": {
          "--primary-color": "#869a4d",
          "--primary-inverse-color": "#fff",
          "--accent-color": "#e58e3d",
          "--accent-inverse-color": "#fff",
          "--light-color": "#f9f6ef",
          "--light-inverse-color": "#472c1d",
          "--primary-light-color": "#efefdf",
          "--bg-inverse-color": "#472c1d"
        }
      },
      "green": {
        "label": "グリーン",
        "tokens": {
          "--primary-color": "#2d8f5f",
          "--primary-inverse-color": "#fff",
          "--accent-color": "#5cb88a",
          "--accent-inverse-color": "#fff",
          "--light-color": "#eef8f2",
          "--light-inverse-color": "#333"
        }
      },
      "blue": {
        "label": "ブルー",
        "tokens": {
          "--primary-color": "#1f6bbe",
          "--primary-inverse-color": "#fff",
          "--accent-color": "#2eb8cb",
          "--accent-inverse-color": "#fff",
          "--light-color": "#f0f7fb",
          "--light-inverse-color": "#333"
        }
      },
      "navy": {
        "label": "ネイビー",
        "tokens": {
          "--primary-color": "#101f3a",
          "--primary-inverse-color": "#fff",
          "--accent-color": "#7b8269",
          "--accent-inverse-color": "#fff",
          "--light-color": "#f2f5f9",
          "--light-inverse-color": "#101f3a"
        }
      },
      "pink": {
        "label": "ピンク",
        "tokens": {
          "--primary-color": "#ff9999",
          "--primary-inverse-color": "#fff",
          "--accent-color": "#ec6262",
          "--accent-inverse-color": "#fff",
          "--light-color": "#fff5f5",
          "--light-inverse-color": "#333",
          "--bg-color": "#fff",
          "--bg-inverse-color": "#333"
        }
      }
    }
  },
  "sections": [
    {
      "id": "greetings",
      "label": "ご挨拶",
      "selector": "#greetings",
      "visible": true,
      "navHrefs": [
        "#greetings"
      ],
      "removable": true
    },
    {
      "id": "info",
      "label": "お知らせ",
      "selector": "#info",
      "visible": true,
      "navHrefs": [
        "#info"
      ],
      "removable": true
    },
    {
      "id": "service",
      "label": "サービス",
      "selector": "#service",
      "visible": true,
      "navHrefs": [
        "#service",
        "#service1",
        "#service2",
        "#service3"
      ],
      "removable": true
    },
    {
      "id": "faq",
      "label": "よくある質問",
      "selector": "#faq",
      "visible": true,
      "navHrefs": [
        "#faq"
      ],
      "removable": true
    },
    {
      "id": "access",
      "label": "アクセス",
      "selector": "#access",
      "visible": true,
      "navHrefs": [
        "#access"
      ],
      "removable": true
    },
    {
      "id": "contact",
      "label": "お問い合わせ",
      "selector": "#contact",
      "visible": true,
      "navHrefs": [
        "#contact"
      ],
      "removable": false
    }
  ],
  "layout": {
    "serviceColumns": {
      "label": "サービスカードのカラム数",
      "value": 3,
      "cssVar": "--layout-service-columns",
      "min": 1,
      "max": 4,
      "appliesTo": ".list1"
    },
    "contentSpace": {
      "label": "左右余白（大）",
      "value": "5vw",
      "cssVar": "--content-space-l",
      "appliesTo": ":root --content-space-l"
    }
  },
  "customCss": {
    "file": "css/custom.css",
    "content": "",
    "description": "管理画面から注入する追加CSS。このファイル内容を丸ごと置換する。"
  },
  "contentSlots": [
    {
      "id": "title",
      "label": "ページタイトル",
      "selector": "title",
      "type": "text"
    }
  ],
  "imageSlots": [
    {
      "id": "logo",
      "label": "ロゴ",
      "path": "images/logo.png",
      "selector": "img[src*='logo']"
    }
  ]
}
