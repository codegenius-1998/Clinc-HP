{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinc-hp.local/schema/template-variables.schema.json",
  "title": "Clinic HP Template Variables",
  "type": "object",
  "required": ["templateId", "version", "colorScheme", "sections", "layout", "customCss", "apply"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "templateId": {
      "type": "string",
      "description": "ディレクトリ名と一致するテンプレートID"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "variables.json のスキーマ版"
    },
    "meta": {
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "themeFile": { "type": "string", "description": "既定カラートークンが定義されているCSSファイル" },
        "htmlFile": { "type": "string", "default": "index.html" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "apply": {
      "type": "object",
      "description": "AI/ツールが値を書き戻す先",
      "required": ["htmlFile", "themeAttribute", "controlsCssFile", "customCssFile"],
      "properties": {
        "htmlFile": { "type": "string" },
        "themeAttribute": { "type": "string", "const": "html[data-theme]" },
        "controlsCssFile": { "type": "string" },
        "customCssFile": { "type": "string" },
        "layoutStyleTarget": {
          "type": "string",
          "description": "レイアウトCSS変数を書く要素。通常は html"
        }
      },
      "additionalProperties": false
    },
    "colorScheme": {
      "type": "object",
      "required": ["active", "options"],
      "properties": {
        "active": { "type": "string" },
        "options": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["label", "tokens"],
            "properties": {
              "label": { "type": "string" },
              "tokens": {
                "type": "object",
                "additionalProperties": { "type": "string" },
                "description": "CSSカスタムプロパティ名 → 値"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "selector", "visible"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string" },
          "selector": { "type": "string" },
          "visible": { "type": "boolean" },
          "navHrefs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "removable": { "type": "boolean", "default": true },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["label", "value", "cssVar"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": ["number", "string"] },
          "cssVar": { "type": "string", "pattern": "^--" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "unit": { "type": "string" },
          "appliesTo": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "customCss": {
      "type": "object",
      "required": ["file", "content"],
      "properties": {
        "file": { "type": "string" },
        "content": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "contentSlots": {
      "type": "array",
      "description": "テキスト差し替え用の索引（プレビュー編集機能向け）",
      "items": {
        "type": "object",
        "required": ["id", "label", "selector"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "selector": { "type": "string" },
          "type": { "type": "string", "enum": ["text", "html", "attr"] },
          "attr": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "imageSlots": {
      "type": "array",
      "description": "画像差し替え用の索引（プレビュー編集機能向け）",
      "items": {
        "type": "object",
        "required": ["id", "label", "path"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "path": { "type": "string" },
          "selector": { "type": "string" },
          "aspectHint": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
