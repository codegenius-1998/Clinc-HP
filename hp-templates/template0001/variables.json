{
  "templateId": "template0001",
  "meta": {
    "label": "クリニック",
    "themeFile": "css/style.css",
    "htmlFile": "index.html",
    "notes": "本ファイルがテンプレートの正本。管理画面の表示制御・AI生成の両方から参照する。AI_GUIDE.md は使わない。"
  },
  "apply": {
    "htmlFile": "index.html",
    "themeAttribute": "html[data-theme]",
    "controlsCssFile": "css/site-controls.css",
    "customCssFile": "css/custom.css",
    "layoutStyleTarget": "html"
  },
  "colorScheme": {
    "howToChange": [
      "通常の配色変更は active だけを書き換える。値は options のキー（skyblue / blue / green / navy / pink）のいずれか1つ。",
      "システムは html の data-theme 属性に active の値をそのままセットする（例: active=\"green\" → <html data-theme=\"green\">）。",
      "options のキー以外の文字列を active に入れない。新規配色が必要なら、先に options へキーを追加し、css/site-controls.css に html[data-theme=\"そのキー\"] のトークン定義を追加してから active を切り替える。",
      "tokens は各配色の CSS 変数値の正本メモ。個別の色味だけ変えたい場合は該当 options.*.tokens を変更し、同じ内容を css/site-controls.css の対応ブロックへ同期する。active の切替だけでは tokens を編集しない。"
    ],
    "active": "skyblue",
    "options": {
      "skyblue": {
        "label": "スカイブルー",
        "tokens": {
          "--primary-color": "#4ba3fc",
          "--primary-inverse-color": "#fff",
          "--accent-color": "#2d7dd2",
          "--accent-inverse-color": "#fff",
          "--light-color": "#e8f4ff",
          "--light-inverse-color": "#333"
        }
      },
      "blue": {
        "label": "ブルー",
        "tokens": {
          "--primary-color": "#1f6bbe",
          "--primary-inverse-color": "#fff",
          "--accent-color": "#2eb8cb",
          "--accent-inverse-color": "#fff",
          "--light-color": "#f0f7fb",
          "--light-inverse-color": "#333"
        }
      },
      "green": {
        "label": "グリーン",
        "tokens": {
          "--primary-color": "#2d8f5f",
          "--primary-inverse-color": "#fff",
          "--accent-color": "#5cb88a",
          "--accent-inverse-color": "#fff",
          "--light-color": "#eef8f2",
          "--light-inverse-color": "#333"
        }
      },
      "navy": {
        "label": "ネイビー",
        "tokens": {
          "--primary-color": "#101f3a",
          "--primary-inverse-color": "#fff",
          "--accent-color": "#7b8269",
          "--accent-inverse-color": "#fff",
          "--light-color": "#f2f5f9",
          "--light-inverse-color": "#101f3a"
        }
      },
      "pink": {
        "label": "ピンク",
        "tokens": {
          "--primary-color": "#ff9999",
          "--primary-inverse-color": "#fff",
          "--accent-color": "#ec6262",
          "--accent-inverse-color": "#fff",
          "--light-color": "#fff5f5",
          "--light-inverse-color": "#333",
          "--bg-color": "#fff",
          "--bg-inverse-color": "#333"
        }
      }
    }
  },

  "sectionGuide": {
    "summary": "単一ページLP。ヘッダー／メインビジュアル／本文セクション／ギャラリー／フッターで構成する。セクションの表示切替は sections[].visible と data-visible で行い、非表示時は navHrefs のナビ項目も連動して隠す。",
    "pageFlow": [
      "header（ロゴ・バナー・電話・文字サイズ）",
      "menubar（ページ内アンカーナビ）",
      "mainimg（ヒーロースライド＋予約CTA）",
      "about → service → staff → faq → access → contact",
      "thumbnail-slide（ギャラリー）",
      "footer-contents / footermenu / footer"
    ],
    "rules": [
      "removable: true のセクションのみ、ヒアリング内容で埋められない場合に非表示にしてよい。",
      "contact は常に表示（removable: false）。",
      "迷ったら表示のままにする。",
      "セクションを非表示にするときは selector の data-visible=\"false\" と、navHrefs に対応するナビ li を非表示にする。"
    ]
  },
  "sections": [
    {
      "id": "about",
      "label": "当院について",
      "selector": "#about",
      "visible": true,
      "navHrefs": ["#about"],
      "removable": true,
      "description": "医院紹介の中核。内部ブロック #link1（当院について）・#link2（初診の方へ）・#link3（院長挨拶）で構成する。",
      "blocks": [
        { "id": "link1", "label": "当院について", "role": "医院の概要・方針の紹介文と内観写真" },
        { "id": "link2", "label": "初診の方へ", "role": "初診案内の説明文と雰囲気写真" },
        { "id": "link3", "label": "院長挨拶", "role": "院長の挨拶文とスタッフ／院長写真" }
      ]
    },
    {
      "id": "service",
      "label": "診療案内",
      "selector": "#service",
      "visible": true,
      "navHrefs": ["#service"],
      "removable": true,
      "description": "診療科目カード（.list-grid1）と医師出勤表（.ta-box）。カード数は layout.serviceColumns で調整する。出勤表の人名リンクは #staff 内の各スタッフ id へ接続する。",
      "blocks": [
        { "id": "service-cards", "label": "診療科目カード", "role": "科目名＋短い説明＋関連写真" },
        { "id": "doctor-schedule", "label": "医師出勤表", "role": "曜日ごとの担当医。実データが無ければ仮想資料として非表示にする" }
      ]
    },
    {
      "id": "staff",
      "label": "スタッフ紹介",
      "selector": "#staff",
      "visible": true,
      "navHrefs": ["#staff"],
      "removable": true,
      "description": "スタッフ一人あたり .list-half（テキスト＋写真）。各ブロックの id（#nihon / #okinawa / #tokyo など）が出勤表からのアンカー先になる。実在スタッフ情報が無ければセクションごと非表示にしてよい。"
    },
    {
      "id": "faq",
      "label": "よくある質問",
      "selector": "#faq",
      "visible": true,
      "navHrefs": ["#faq"],
      "removable": true,
      "description": "dl.faq の Q&A。ヒアリングの特徴・要望から一般的な質問を生成してよい。固有の制度・料金など不明な事実は創作せず Hidden にする。"
    },
    {
      "id": "access",
      "label": "アクセス",
      "selector": "#access",
      "visible": true,
      "navHrefs": ["#access"],
      "removable": true,
      "description": "Google Maps iframe と住所テーブル。住所がヒアリングにあれば地図クエリを差し替え、無ければ仮想の地図・マニュアルリンクは非表示にする。"
    },
    {
      "id": "contact",
      "label": "お問い合わせ",
      "selector": "#contact",
      "visible": true,
      "navHrefs": ["#contact"],
      "removable": false,
      "description": "電話・LINE の相談／予約ボタン。常に表示。番号・LINE ID が無ければ該当ボタンだけ Hidden で隠す。"
    }
  ],

  "imageGuide": {
    "summary": "ユーザーはヒアリング画面でカテゴリ別に実写をアップロードする。各画像枠へは AI がカテゴリ照合し、合う写真があればそのまま使用、無ければ AI 生成する。ロゴは常に AI 生成（アップロード対象外）。",
    "inputCategories": [
      {
        "key": "exterior",
        "label": "外部写真",
        "whatToUpload": "医院の外観・入口・看板・建物まわり。",
        "usedFor": ["ヒーロー背景の外観表現", "ギャラリーの外観カット", "アクセス周辺の雰囲気"]
      },
      {
        "key": "interior",
        "label": "内部写真",
        "whatToUpload": "受付・待合・廊下・診察室など院内の空間。",
        "usedFor": ["#about の医院紹介写真", "診療科目カードの院内カット", "ギャラリーの内観"]
      },
      {
        "key": "director",
        "label": "スタッフ写真",
        "whatToUpload": "院長・医師・スタッフの人物写真（顔がはっきり写る実写を推奨）。",
        "usedFor": ["#about の院長挨拶写真", "#staff の各スタッフ写真", "出勤表と対応する人物カット"]
      },
      {
        "key": "atmosphere",
        "label": "治療雰囲気写真",
        "whatToUpload": "診療・施術の雰囲気が伝わる写真（手元・機器まわり・患者対応の様子など。顔のクローズアップは避ける）。",
        "usedFor": ["初診案内の挿絵", "診療科目カード", "ギャラリーの施術雰囲気"]
      },
      {
        "key": "equipment",
        "label": "治療機器",
        "whatToUpload": "医療機器・設備の写真。",
        "usedFor": ["診療科目・設備紹介の挿絵", "ギャラリーの機器カット"]
      }
    ],
    "generationRules": [
      "アップロード写真は加工せずそのまま掲載する。同一写真の重複利用はしない（カテゴリ内で使い切ったら以降は AI 生成）。",
      "style は配置役割で決める: logo（フラットなベクター調ロゴ）/ icon（装飾アイコン）/ photo（実写風）。",
      "logo: PNG または SVG で書き出す。背景は必ず透明（Bgなし／transparent）。白・単色の塗り背景や白キャンバスを付けない。読める文字を含めない。医療を連想させるシンプルな図形。",
      "icon: 読める文字を含めない。医療を連想させるシンプルな図形。",
      "photo: 明るく清潔感のある医療機関らしい実写。顔のクローズアップ・透かし・文字入れ禁止。",
      "どの入力カテゴリにも合わない枠（ロゴ・バナー装飾など）は AI 生成に回す。",
      "画像生成・差し替え時は size.width / size.height（元ピクセル）を目安にする。厳密一致は不要だが、aspectRatio は崩さない。",
      "全ての画像で、白い余白・白フチ・パディング状の空白帯を画像内に作らない。被写体または図形がキャンバス端まで届く（edge-to-edge / full-bleed）こと。上下左右に白い枠やレターボックスを入れない。"
    ],
    "logoFormat": {
      "formats": ["png", "svg"],
      "background": "transparent",
      "rule": "ロゴ（style: logo / images/logo.png / images/logo_footer.png）は PNG または SVG で作成し、背景なし（透明）にする。不透明な白背景・単色背景は禁止。"
    },
    "noWhiteMargin": {
      "required": true,
      "rule": "全ての画像（logo / icon / photo およびアップロード実写）について、画像ファイル内に白い空白余白を生じさせない。",
      "do": [
        "被写体・図形・背景をキャンバスの四辺まで伸ばす（full-bleed）",
        "アスペクト比は size / display に合わせ、余白で埋めずに構図で合わせる",
        "ロゴは PNG/SVG・透明背景で書き出し、マーク自体に白キャンバスを付けない"
      ],
      "dont": [
        "上下左右の白い帯・白フチ・パディング",
        "レターボックス／ピラーボックス（黒帯を含む無地帯）",
        "小さな被写体を中央に置き周囲を白で埋める構図",
        "ロゴを不透明な白／単色背景つきで書き出すこと"
      ]
    },
    "sizeSource": "元サイズはテンプレート同梱サンプルの実寸。display は index.html + css/style.css / css/slide.css の表示指定。",
