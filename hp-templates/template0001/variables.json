  "textGuide": {
    "summary": "ヒアリングシートの実データを正とし、ページ内テキストを AI が要素単位で書き換える。不明な固有事実は創作せず Hidden（非表示）にする。",
    "hearingInputs": [
      { "key": "clinicName", "label": "クリニック名", "required": true, "usage": "タイトル・ロゴalt・コピーライト・ヒーロー文言" },
      { "key": "directorName", "label": "院長名", "required": false, "usage": "院長挨拶・スタッフ紹介" },
      { "key": "address", "label": "住所", "required": false, "usage": "フッター住所・アクセス表・地図クエリ" },
      { "key": "phone", "label": "電話番号", "required": false, "usage": "ヘッダー・予約CTA・お問い合わせの tel: リンク（システムが直接差し替え）" },
      { "key": "line", "label": "LINE ID", "required": false, "usage": "お問い合わせ／フッターの LINE リンク（システムが直接差し替え）" },
      { "key": "department", "label": "診療科", "required": false, "usage": "診療科目カードの見出し・説明" },
      { "key": "hours", "label": "診療時間", "required": false, "usage": "ヘッダー受付時間・フッター診療時間表" },
      { "key": "features", "label": "医院の特徴", "required": false, "usage": "紹介文・FAQ・ヒーローキャッチの素材" },
      { "key": "request", "label": "ご要望", "required": false, "usage": "トーンや強調したい点の反映" }
    ],
    "generationRules": [
      "電話・住所・LINE・診療時間は、ヒアリングにあれば一字一句そのまま使う。無ければ Hidden。",
      "資格・実績年数・症例数など具体的事実も、記載が無ければ Hidden（創作禁止）。",
      "見出し・紹介文・特徴・案内・ボタン文言など一般コピーは、特徴・要望を踏まえて自然な日本語に書き換えてよい。",
      "ナビラベルや著作権表記は無理に変えず、医院名だけ差し替える程度でよい。",
      "元の役割と文字量バランスを大きく崩さない（見出しは短く、本文は同程度のボリューム）。",
      "電話番号テキストはコピー生成に回さず、システムが hearing.phone または Hidden で確定する。"
    ]
  },
